<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Sin este permiso la app se cierra apenas intenta llamar a la API. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Desde Android 13 el usuario tiene que aceptar las notificaciones. Se pide al
     entrar al panel; en versiones anteriores se concede sola al instalar. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AgroWatchMobile"
        tools:targetApi="31">

        <!-- La puerta de entrada: si ya hay sesión, pasa directo al panel. -->
        <activity
            android:name=".login.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".panel.PanelActivity"
            android:exported="false" />

        <activity
            android:name=".lote.LoteActivity"
            android:exported="false"
            android:parentActivityName=".panel.PanelActivity" />

        <activity
            android:name=".costo.NuevoCostoActivity"
            android:exported="false"
            android:parentActivityName=".lote.LoteActivity"
            android:windowSoftInputMode="adjustResize" />
        <!-- El intent-filter es lo que le dice al sistema que esta clase es la que recibe
     los mensajes de FCM. Sin el, el servicio nunca se ejecuta. -->
        <service
            android:name=".avisos.AvisosService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Cuando la app esta en segundo plano la notificacion la arma el sistema, no
             nuestro servicio: estos dos valores le dicen que canal e icono usar. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="avisos" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_aviso" />
    </application>

</manifest>
